# mu2edaq-env.sh -- environment for an installed mu2edaq-shifter-tools
#
# Generated by CMake at configure time for
#   prefix @CMAKE_INSTALL_PREFIX@
#   python @Python3_VERSION_MAJOR@.@Python3_VERSION_MINOR@
#
# Source this to put the installed toolkit on your PATH:
#
#     source @CMAKE_INSTALL_PREFIX@/@MU2EDAQ_SHAREDIR@/mu2edaq-env.sh
#
# PYTHONPATH is required, not optional: the package is installed with
# "pip install --prefix", which places it in
# <prefix>/lib/pythonX.Y/site-packages -- a directory that is not on the
# default sys.path of a system interpreter. Without it the daq-* console
# scripts fail with ModuleNotFoundError.

_mu2edaq_prefix="@CMAKE_INSTALL_PREFIX@"
_mu2edaq_share="$_mu2edaq_prefix/@MU2EDAQ_SHAREDIR@"
_mu2edaq_site="$_mu2edaq_prefix/@CMAKE_INSTALL_LIBDIR@/python@Python3_VERSION_MAJOR@.@Python3_VERSION_MINOR@/site-packages"

# Where config/ and data/ live.
export MU2EDAQ_ROOT="$_mu2edaq_share"

case ":${PATH}:" in
    *":$_mu2edaq_prefix/@CMAKE_INSTALL_BINDIR@:"*) ;;
    *) export PATH="$_mu2edaq_prefix/@CMAKE_INSTALL_BINDIR@:$PATH";;
esac

case ":${MANPATH-}:" in
    *":$_mu2edaq_prefix/@CMAKE_INSTALL_MANDIR@:"*) ;;
    *) export MANPATH="$_mu2edaq_prefix/@CMAKE_INSTALL_MANDIR@:${MANPATH-}";;
esac

if [ -d "$_mu2edaq_site" ]; then
    case ":${PYTHONPATH-}:" in
        *":$_mu2edaq_site:"*) ;;
        *) export PYTHONPATH="$_mu2edaq_site${PYTHONPATH:+:$PYTHONPATH}";;
    esac
else
    echo "mu2edaq-env.sh: warning: $_mu2edaq_site does not exist;" \
         "the daq-* commands will not import" >&2
fi

unset _mu2edaq_prefix _mu2edaq_share _mu2edaq_site
