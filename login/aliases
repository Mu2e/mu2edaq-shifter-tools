# .aliases
#
# Shell aliases for the Mu2e DAQ shifter accounts.
# Sourced from .bashrc; installed by install-login.sh from login/aliases.

alias ll='ls -l --color=auto'
alias l='ll'
alias rgrep='grep -R'
alias ccgrep="grep -R --include='*.cc'"
alias hgrep="grep -R --include='*.h'"
alias srcgrep="grep -R --include='*.cc' --include='*.h'"
alias less='less -S' #no word wrap
alias sshx='ssh-selector -c ~/config/mu2e_daq.yaml'
alias nodes='ssh-selector -c ~/config/mu2e_daq.yaml'

# setup-online.sh has to be sourced to be useful: it cds into the test
# release and defines the ots environment in this shell.
alias setup_online='source $HOME/bin/setup-online.sh'
alias setup-online='source $HOME/bin/setup-online.sh'

# Shorthands for the partition lifecycle commands (all installed in ~/bin).
alias daq-status='daq-status.sh'
alias start-daq='start-daq.sh'
alias stop-daq='stop-daq.sh'

# Restart the ots instances with the operations checkout's script.
alias restart_ots='~/ots_ops/daq-operations/restart_ots.sh'

# CRV power-over-ethernet control and ROC consoles, reachable only from
# the DCS host. The home directory is NFS-shared across the cluster, so
# the hostname picks where these exist.
if [[ "$(hostname -s)" == "mu2e-dcs-01" ]]; then
    alias crv-poe='python3 ~/CRVFirmware/scripts/poe_ctl.py'
    alias crv-roc1='telnet 192.168.157.91 5003'
    alias crv-roc2='telnet 192.168.157.92 5003'
fi
