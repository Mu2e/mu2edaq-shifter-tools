# Environment overrides for the Mu2e DAQ shifter tools.
#
# Copy to .env in the installation root (or point $MU2EDAQ_DOTENV at it).
# Values here rank BELOW the real environment and BELOW any command line
# option, and ABOVE the YAML config files:
#
#     command line > environment > .env > config file > default
#
# Every variable is optional.

# --- Locations -----------------------------------------------------------
# Installation root. Normally auto-detected by walking up from the
# scripts, so only set this for an unusual deployment.
#MU2EDAQ_ROOT=/home/mu2edaq/daq-shifter-tools

# Extra directory searched first for config files.
#MU2EDAQ_CONFIG_DIR=/home/mu2edaq/my-config

# Directory holding the static data files (daq_nodes.json, ...).
#MU2EDAQ_DATA_DIR=/home/mu2edaq/daq-shifter-tools/data

# --- Partition tooling ---------------------------------------------------
# Operations YAML used by start-daq.sh, stop-daq.sh, daq-status.sh,
# setup-online.sh, create-environment.sh and daq-read-config.
#MU2EDAQ_CONFIG=/home/mu2edaq/daq-shifter-tools/config/daq-operations.yaml

# Default partition and environment, so -z/-e can be omitted.
#MU2EDAQ_PARTITION=partition_0
#MU2EDAQ_ENVIRONMENT=tracker

# Seconds stop-daq.sh waits for a clean ots shutdown before killing the
# tmux session.
#MU2EDAQ_STOP_TIMEOUT=30

# otsdaq-mu2e ref that create-environment.sh fetches the spack
# quick-start helper from.
#MU2EDAQ_OTSDAQ_REF=develop

# Gateway host that send-run-control-command.sh targets.
#MU2EDAQ_RC_HOST=localhost

# --- Tunnels -------------------------------------------------------------
# Tunnel definition file, local port base, and where running tunnels are
# recorded.
#MU2EDAQ_TUNNELS=/home/mu2edaq/daq-shifter-tools/config/tunnels.yaml
#MU2EDAQ_TUNNEL_BASE_PORT=1973
#MU2EDAQ_TUNNEL_STATE=~/.mu2edaq/open_tunnels

# --- Cluster copy --------------------------------------------------------
#MU2EDAQ_CLUSTER_USER=mu2edaq
#MU2EDAQ_CLUSTER_JOBS=16

# --- tmux workspace ------------------------------------------------------
#MU2EDAQ_TMUX_SESSION=daq
#MU2EDAQ_TMUX_CWD=/home/mu2edaq

# --- Network verification ------------------------------------------------
#MU2EDAQ_NETWORKS="control=192.168.6.0/24 data=192.168.7.0/24 ipmi=192.168.157.0/24"
#MU2EDAQ_NETVERIFY_DIR=/tmp

# --- VNC / noVNC (scripts/manage-vnc-servers.sh, start-novnc-connection.sh) ---
#VNC_HOST=mu2e-mgr-01.fnal.gov
#VNC_USER=mu2ecr01
#VNC_PORTS="4 5 6 7 8 9"
#NOVNC_HOST=mu2e-mgr-01.fnal.gov
#NOVNC_USER=mu2ecr01
#NOVNC_PROXY_JUMP=mu2egateway01.fnal.gov
#NOVNC_LOCAL_PORT=
#NOVNC_REMOTE_PORT=443
#NOVNC_PASSWORD_FILE=~/.novnc_password

# --- Kerberos / git ------------------------------------------------------
#KRB5_KEYTAB_DIR=~/.krb5
#GIT_SSH_KEY=~/.ssh/id_mu2eshift_rsa
